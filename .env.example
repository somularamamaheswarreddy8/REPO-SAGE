# ==========================================
# RepoSage Environment Configuration
# ==========================================

# Application Settings
ENVIRONMENT=development
DEBUG=false
APP_NAME=RepoSage

# Database (PostgreSQL with pgvector)
# For local containerized setup:
DATABASE_URL=postgresql+asyncpg://reposage:reposage_password@localhost:5432/reposage
SYNC_DATABASE_URL=postgresql://reposage:reposage_password@localhost:5432/reposage
POSTGRES_USER=reposage
POSTGRES_PASSWORD=reposage_password
POSTGRES_DB=reposage

# For lightweight SQLite testing (set to: sqlite+aiosqlite:///./reposage.db):
# DATABASE_URL=sqlite+aiosqlite:///./reposage.db
# SYNC_DATABASE_URL=sqlite:///./reposage.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# AI Providers Configuration
# Supported options: "mock", "openai", "anthropic", "gemini"
DEFAULT_LLM_PROVIDER=mock
DEFAULT_EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1536

# OpenAI Credentials (optional, leave blank to use Demo Mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Credentials (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini Credentials (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# GitHub App Integration
# Leave blank to use Demo Mode (simulates GitHub API with pre-seeded repos)
MOCK_GITHUB_ENABLED=true
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Observability (OpenTelemetry)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=reposage-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
